"use client";

import { useState } from "react";
import { Chess } from "chess.js";
import { Canvas } from "@react-three/fiber";
import { OrbitControls, Text, RoundedBox } from "@react-three/drei";

type Square = import("chess.js").Square;

const names: Record<string, string> = {
p: "P", r: "R", n: "N", b: "B", q: "Q", k: "K"
};


function Piece({ type, color, x, z, onClick }: {
  type: string; color: string; x: number; z: number;
  onClick: () => void;
}) {
  const white = color === "w";
  const main = white ? "#f4e5c8" : "#111318";
  const trim = white ? "#caa76a" : "#626a77";
  const material = <meshPhysicalMaterial color={main} metalness={0.22} roughness={0.16} clearcoat={1} clearcoatRoughness={0.08} />;
  const base = (radius: number, height: number, y: number) => (
    <mesh position={[0,y,0]}>
      <cylinderGeometry args={[radius,radius,height,40]}/>
      {material}
    </mesh>
  );
  return (
    <group position={[x,0.12,z]} onClick={(e) => {e.stopPropagation();onClick();}}>
      {base(0.34,0.10,0.04)}
      {base(0.29,0.08,0.13)}
      <mesh position={[0,0.33,0]}>
        <cylinderGeometry args={[0.16,0.25,0.35,40]}/>
        {material}
      </mesh>
      {type === "p" && <mesh position={[0,0.58,0]}><sphereGeometry args={[0.16,32,24]}/>{material}</mesh>}
      {type === "r" && <>
        {base(0.27,0.15,0.63)}
        {[0,1,2,3].map(i => <mesh key={i} position={[Math.cos(i*Math.PI/2)*0.20,0.75,Math.sin(i*Math.PI/2)*0.20]}><boxGeometry args={[0.15,0.17,0.15]}/>{material}</mesh>)}
      </>}
      {type === "n" && <>
        <mesh position={[0,0.64,0]} rotation={[0,0,-0.30]}>
          <boxGeometry args={[0.27,0.48,0.23]}/>{material}
        </mesh>
        <mesh position={[0.09,0.88,0]}><boxGeometry args={[0.34,0.17,0.24]}/>{material}</mesh>
      </>}
      {type === "b" && <>
        <mesh position={[0,0.69,0]}><sphereGeometry args={[0.22,32,24]}/>{material}</mesh>
        <mesh position={[0,0.92,0]}><sphereGeometry args={[0.07,24,16]}/><meshStandardMaterial color={trim}/></mesh>
      </>}
      {type === "q" && <>
        {base(0.29,0.12,0.72)}
        {[0,1,2,3,4].map(i => <mesh key={i} position={[Math.cos(i*2*Math.PI/5)*0.22,0.88,Math.sin(i*2*Math.PI/5)*0.22]}><sphereGeometry args={[0.075,16,12]}/><meshStandardMaterial color={trim} metalness={0.65} roughness={0.2}/></mesh>)}
      </>}
      {type === "k" && <>
        {base(0.25,0.14,0.77)}
        <mesh position={[0,0.99,0]}><boxGeometry args={[0.11,0.36,0.11]}/>{material}</mesh>
        <mesh position={[0,1.06,0]}><boxGeometry args={[0.30,0.10,0.11]}/>{material}</mesh>
      </>}
    </group>
  );
}
function Board({ game, selected, play }: {
game: Chess; selected: Square | null;
play: (square: Square) => void;
}) {
const squares = [];
for (let rank = 0; rank < 8; rank++) {
for (let file = 0; file < 8; file++) {
        const square = `${"abcdefgh"[file]}${8-rank}` as Square;
        const piece = game.get(square);
        const x = file - 3.5;
const z = rank - 3.5;
const light = (rank + file) % 2 === 0;
squares.push(
<group key={square}>
<mesh
position={[x, 0, z]}
onClick={(e) => { e.stopPropagation(); play(square); }}
>
<boxGeometry args={[1, 0.16, 1]}/>
<meshStandardMaterial
color={selected === square ? "#e8ad43" : light ? "#e6c69a" : "#51301e"}
roughness={0.08} metalness={0.28}
/>
</mesh>
{piece && (
<Piece
type={piece.type}
color={piece.color}
x={x}
z={z}
onClick={() => play(square)}
/>
)}
</group>
);
}
}
 return (
<>
<color attach="background" args={["#181410"]}/>
<ambientLight intensity={1.5}/>
<directionalLight position={[4, 10, 5]} intensity={2.6}/>
<pointLight position={[-5, 5, -3]} intensity={45} color="#7ec9ff"/>
<mesh position={[0, -0.075, 0]}>
  <boxGeometry args={[8.22, 0.035, 8.22]} />
  <meshStandardMaterial color="#c89545" metalness={0.85} roughness={0.12} />
</mesh>
<RoundedBox args={[8.5, 0.4, 8.5]} radius={0.12} position={[0, -0.28, 0]}>
<meshStandardMaterial color="#27170f" metalness={0.65} roughness={0.08}/>
</RoundedBox>
{squares}
<OrbitControls  
enablePan={false}  
minDistance={9}  
maxDistance={17}  
minPolarAngle={0.35}  
maxPolarAngle={1.35}  
/>
</>
);
}

export default function Home() {
const [game, setGame] = useState(() => new Chess());
const [selected, setSelected] = useState<Square | null>(null);
const [message, setMessage] = useState("White to move");
const [fee, setFee] = useState("20");

function play(square: Square) {
const piece = game.get(square);
if (!selected) {
if (piece?.color === game.turn()) setSelected(square);
return;
}
const next = new Chess(game.fen());
try {
next.move({ from: selected, to: square, promotion: "q" });
setGame(next);
setMessage(next.isCheckmate()
? "Checkmate!"
: next.isDraw()
? "Draw!"
: next.turn() === "w" ? "White to move" : "Black to move");
setSelected(null);
} catch {
setSelected(piece?.color === game.turn() ? square : null);
}
}

function reset() {
setGame(new Chess());
setSelected(null);
setMessage("White to move");
}

const panel: React.CSSProperties = {
background: "#192638",
border: "1px solid #30465c",
borderRadius: 16,
padding: 18,
marginTop: 18
};

return (
<main style={{
minHeight: "100vh", background: "#0b1420",
color: "#edf3f8", padding: "18px",
fontFamily: "Arial, sans-serif"
}}>
<header style={{ textAlign: "center", marginBottom: 14 }}>
<h1 style={{ color: "#e2bb70", marginBottom: 5 }}>
♛ CHESS ARENA
</h1>
<p style={{ color: "#9baec0" }}>
3D Chess • Tournaments • Competition
</p>
</header>

<section style={{  
    height: "min(65vh, 620px)",  
    minHeight: 360,  
    borderRadius: 18,  
    overflow: "hidden",  
    border: "1px solid #40566b"  
  }}>  
    <Canvas camera={{ position: [0, 10, 10], fov: 48 }}>  
      <Board game={game} selected={selected} play={play}/>  
    </Canvas>  
  </section>  

  <div style={{ textAlign: "center", padding: 14 }}>  
    <strong>{message}</strong>  
    <p style={{ color: "#9baec0", fontSize: 13 }}>  
      Tap a piece, then tap its destination. Drag to rotate the board.  
    </p>  
    <button onClick={reset} style={{  
      background: "#d5aa62", color: "#111",  
      border: 0, borderRadius: 9,  
      padding: "12px 24px", fontWeight: "bold"  
    }}>  
      New Game  
    </button>  
  </div>  

  <section style={panel}>  
    <h2>♟ Player Accounts</h2>  
    <p>Registration and login — coming soon</p>  
  </section>  

  <section style={panel}>  
    <h2>🏆 Tournaments</h2>  
    <label>Entry fee (€)</label>  
    <input  
      type="number" min="0" max="10000"  
      value={fee}  
      onChange={e => setFee(e.target.value)}  
      style={{  
        display: "block", marginTop: 10,  
        padding: 12, borderRadius: 8,  
        width: "100%", maxWidth: 260,  
        background: "#181410", color: "white",  
        border: "1px solid #50677c"  
      }}  
    />  
    <p style={{ color: "#9baec0" }}>  
      Configurable entry fee: €0–€10,000  
    </p>  
  </section>  

  <section style={panel}>  
    <h2>🥇 Prizes</h2>  
    <p style={{ color: "#9baec0" }}>  
      Prize structure to be announced.  
    </p>  
  </section>  
</main>

);
}

